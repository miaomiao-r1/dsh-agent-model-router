{
  "name": "dsh-agent-model-router",
  "version": "1.0.0-rc.1",
  "description": "配合 dsh-our-free-model 利用可用免费额度，支持五角色分别映射、跨工作区共享设置、新旧会话各自保留映射和分阶段交接",
  "keywords": ["dsh-plugin", "deepseek-harness", "agent", "workflow", "model-router"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miaomiao-r1/dsh-agent-model-router.git"
  },
  "homepage": "https://github.com/miaomiao-r1/dsh-agent-model-router#readme",
  "bugs": {
    "url": "https://github.com/miaomiao-r1/dsh-agent-model-router/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "source",
    "engine",
    "scripts/install.mjs",
    "scripts/uninstall.mjs",
    "cordis.patch.yml",
    "README.md",
    "screenshots.json",
    "assets/agent-models.png",
    "docs/marketplace-release.md",
    "docs/security-review.md",
    "THIRD-PARTY-LICENSE.txt",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:workflow": "node scripts/build-workflow.mjs",
    "check": "node --check index.js && node --check client.js && node --check scripts/verify-package.mjs && node scripts/build-workflow.mjs --check",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dsh": {
    "id": "dsh-agent-model-router",
    "name": "代理模型",
    "version": "1.0.0-rc.1",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "Apache-2.0"
}
